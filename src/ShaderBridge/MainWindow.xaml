<Window x:Class="ShaderBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShaderBridge" Height="760" Width="1160" MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#404040" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ShaderBridge" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Preserve shader work across GPU driver updates — without touching game processes." Opacity="0.72" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="DriverSummaryText" Text="Detecting GPU driver…" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="DriverStateText" Text="" Opacity="0.72" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="Dashboard">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button Content="Scan caches" Click="ScanCaches_Click"/>
                            <Button Content="Create snapshot" Click="CreateSnapshot_Click"/>
                            <Button Content="Arm driver update (VSS)" Click="ArmDriverUpdate_Click"/>
                            <Button Content="Release VSS checkpoint" Click="ReleaseVssCheckpoint_Click"/>
                            <Button Content="Open store" Click="OpenStore_Click"/>
                            <CheckBox x:Name="WatchCheckBox" Content="Watch cache activity" Margin="8,6,0,8" Checked="WatchCheckBox_Changed" Unchecked="WatchCheckBox_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="VssStatusText" Margin="0,0,0,8" Opacity="0.75"
                                   Text="VSS checkpoint: none"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="CacheGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Found" Binding="{Binding Exists}" Width="60"/>
                            <DataGridTextColumn Header="Cache" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Snapshots">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Refresh" Click="RefreshSnapshots_Click"/>
                            <Button Content="Compare" Click="CompareSnapshot_Click"/>
                            <Button Content="Restore missing" Click="RestoreMissing_Click"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" x:Name="SnapshotsList" DisplayMemberPath="DisplayName" SelectionChanged="SnapshotsList_SelectionChanged"/>
                    </Grid>
                    <GroupBox Grid.Column="2" Header="Selected snapshot">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="SnapshotDetailsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"/>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Vulkan Lab">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Pipeline cache file">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VulkanFileText" Margin="0,0,8,8"/>
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseVulkan_Click"/>
                            <Button Grid.Column="2" Content="Inspect" Click="InspectVulkan_Click"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="Current Vulkan device">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VulkanDeviceCombo" DisplayMemberPath="DeviceName" Margin="0,0,8,8"/>
                            <Button Grid.Column="1" Content="Probe Vulkan" Click="ProbeVulkan_Click"/>
                        </Grid>
                    </GroupBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Create UUID-migrated candidate copy" Click="CreateVulkanCandidate_Click"/>
                        <TextBlock VerticalAlignment="Center" Opacity="0.72" Text="Never overwrites the original cache."/>
                    </StackPanel>
                    <GroupBox Grid.Row="3" Header="Inspection / experiment output">
                        <TextBox x:Name="VulkanOutputText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Activity">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Clear" Click="ClearLog_Click"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="ActivityText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                        <GroupBox Header="Snapshot store">
                            <StackPanel>
                                <TextBlock Text="4 MiB content-addressed chunk store. Unchanged blocks across large cache files are stored only once." Margin="0,0,0,6"/>
                                <TextBox x:Name="StoreRootText" Width="820"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Custom cache roots">
                            <StackPanel>
                                <TextBlock Text="One folder per line. Environment variables such as %LOCALAPPDATA% are supported." Margin="0,0,0,6"/>
                                <TextBox x:Name="CustomRootsText" Width="820" Height="160" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Background behavior">
                            <StackPanel>
                                <CheckBox x:Name="SettingsWatchCheckBox" Content="Watch discovered cache folders while ShaderBridge is running" Margin="0,0,0,8"/>
                                <CheckBox x:Name="MinimizeTrayCheckBox" Content="Minimize to notification area instead of closing" Margin="0,0,0,8"/>
                                <CheckBox x:Name="AutoBaselineCheckBox" Content="Automatically create one baseline snapshot per GPU-driver fingerprint" Margin="0,0,0,8"/>
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start ShaderBridge with Windows (current user)" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Driver poll interval (seconds):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="PollSecondsText" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <Button Content="Save settings" Width="140" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><ProgressBar x:Name="BusyProgress" Width="160" Height="14" IsIndeterminate="True" Visibility="Collapsed"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
